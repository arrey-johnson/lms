# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — never expose to the client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Hostinger Email — support@promptstackclassroom.com
# SMTP: smtp.hostinger.com · port 465 (SSL) or 587 (STARTTLS)
# Username = full mailbox address · Password = Hostinger mailbox password
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=support@promptstackclassroom.com
SMTP_PASS=your-hostinger-mailbox-password
SMTP_FROM=support@promptstackclassroom.com
SMTP_FROM_NAME=Promptstack Classroom

# Optional extra pepper for hashing confirmation codes
OTP_PEPPER=change-me-to-a-long-random-string

# xAI tutor — server only. Create a key at console.x.ai. Never expose it to the browser.
XAI_API_KEY=your-xai-api-key
XAI_MODEL=grok-4.7
