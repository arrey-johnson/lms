# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — never expose to the client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Zoho Mail (Promptstack) — hello@promptstacktechnologies.com
# Org domains typically use smtppro.zoho.com (or smtp.zoho.com / regional host).
# Prefer a Zoho App Password: accounts.zoho.com → Security → App Passwords
SMTP_HOST=smtppro.zoho.com
SMTP_PORT=465
SMTP_USER=hello@promptstacktechnologies.com
SMTP_PASS=your-zoho-app-password
SMTP_FROM=hello@promptstacktechnologies.com
SMTP_FROM_NAME=Promptstack Classroom

# Optional extra pepper for hashing confirmation codes
OTP_PEPPER=change-me-to-a-long-random-string
