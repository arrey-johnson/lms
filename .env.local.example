# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — never expose to the client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Hostinger Email — support@promptstackclassroom.com
# SMTP: smtp.hostinger.com · port 465 (SSL) or 587 (STARTTLS)
# Username = full mailbox address · Password = Hostinger mailbox password
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=support@promptstackclassroom.com
SMTP_PASS=your-hostinger-mailbox-password
SMTP_FROM=support@promptstackclassroom.com
SMTP_FROM_NAME=Promptstack Classroom

# CFA francs per 1 USD (Cameroon visitors see FCFA; others see USD)
USD_TO_XAF_RATE=600

# Optional extra pepper for hashing confirmation codes
OTP_PEPPER=change-me-to-a-long-random-string

# xAI tutor — server only. Create a key at console.x.ai. Never expose it to the browser.
XAI_API_KEY=your-xai-api-key
XAI_MODEL=grok-4.7

# Fapshi mobile money — https://dashboard.fapshi.com → Developers → your collection service
# FAPSHI_ENV=sandbox uses test numbers. Switch to live only after the live API key is set.
FAPSHI_ENV=sandbox
FAPSHI_SANDBOX_API_USER=your-sandbox-api-user
FAPSHI_SANDBOX_API_KEY=your-sandbox-api-key
FAPSHI_LIVE_API_USER=your-live-api-user
FAPSHI_LIVE_API_KEY=your-live-api-key
# Same value as the webhook secret saved on the Fapshi service (header x-wh-secret).
FAPSHI_WEBHOOK_SECRET=generate-a-long-random-string
# Public site origin. Required for receipt links and for Fapshi to call the webhook.
APP_URL=https://promptstackclassroom.com
# Optional. Defaults to the support mailbox.
PAYMENTS_NOTIFY_EMAIL=support@promptstackclassroom.com
